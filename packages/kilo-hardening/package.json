{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kilocode/kilo-hardening",
  "version": "7.8.12",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Restricted-egress build: baked config, host allowlist, egress guard and allowlist proxy",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "test:ci": "mkdir -p .artifacts/unit && bun test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "ipaddr.js": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
